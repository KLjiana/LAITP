<Window x:Class="Laitp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAITP 分类实验（M1 骨架）" Height="1000" Width="960">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="新建项目（目录、名称、类别用逗号或空格分隔）" Margin="0,4" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="NewProjectRootBox" Text="{Binding NewProjectRoot, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="项目保存目录，例如 D:\课堂\三年级" />
                <TextBox Grid.Column="1" x:Name="NewProjectNameBox" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" ToolTip="项目名称" />
                <TextBox Grid.Column="2" x:Name="NewProjectClassesBox" Text="{Binding NewProjectClasses, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" ToolTip="类别列表，例如 水杯 书本 笔袋" />
                <Button Grid.Column="3" x:Name="CreateProjectButton" Content="新建并打开" Command="{Binding CreateProjectCommand}"
                        Width="110" Height="26" Margin="8,0,0,0" />
            </Grid>

            <TextBlock Grid.Row="2" Text="项目文件（project.json）" Margin="0,10,0,4" />
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ProjectPathBox"
                         Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" x:Name="OpenProjectButton" Content="打开项目" Command="{Binding OpenProjectCommand}"
                        Width="100" Height="26" Margin="8,0,0,0" />
                <ComboBox Grid.Column="2" x:Name="RecentProjectsBox"
                          ItemsSource="{Binding RecentProjectList}"
                          SelectedItem="{Binding SelectedRecentProject, Mode=TwoWay}"
                          Height="26" Margin="12,0,0,0" ToolTip="最近打开的项目（双击下拉选择后点“打开最近”）" />
                <Button Grid.Column="3" x:Name="OpenRecentButton" Content="打开最近" Command="{Binding OpenRecentCommand}"
                        Width="90" Height="26" Margin="8,0,0,0" />
                <TextBox Grid.Column="4" x:Name="SaveAsPathBox" Text="{Binding SaveAsPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" Margin="12,0,0,0" ToolTip="另存为：新的项目目录（必须不存在或为空）" />
                <Button Grid.Column="5" x:Name="SaveAsButton" Content="另存为" Command="{Binding SaveAsCommand}"
                        Width="90" Height="26" Margin="8,0,0,0" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="项目归档（单文件 ZIP）" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="ArchivePathBox"
                         AutomationProperties.AutomationId="ArchivePathBox"
                         Text="{Binding ArchivePath, UpdateSourceTrigger=PropertyChanged}"
                         Height="26" Margin="8,0,0,0"
                         ToolTip="项目归档 ZIP 路径：导出写入该文件，导入恢复到同目录同名文件夹" />
                <Button Grid.Column="2" x:Name="ExportArchiveButton"
                        AutomationProperties.AutomationId="ExportArchiveButton"
                        Content="导出存档" Command="{Binding ExportArchiveCommand}"
                        Width="90" Height="26" Margin="8,0,0,0" />
                <Button Grid.Column="3" x:Name="ImportArchiveButton"
                        AutomationProperties.AutomationId="ImportArchiveButton"
                        Content="从存档导入" Command="{Binding ImportArchiveCommand}"
                        Width="110" Height="26" Margin="8,0,0,0" />
                <Button Grid.Column="4" x:Name="VerifyProjectButton"
                        AutomationProperties.AutomationId="VerifyProjectButton"
                        Content="校验项目" Command="{Binding VerifyProjectCommand}"
                        Width="90" Height="26" Margin="8,0,0,0"
                        ToolTip="只读校验 project.json、数据清单类别与模型产物摘要，用于课前自检" />
            </Grid>

            <TextBlock Grid.Row="5" Text="{Binding ProjectSummary}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="6" x:Name="ClassesTextBlock"
                       Text="{Binding ClassesText}" Foreground="Gray" Margin="0,2,0,0" />

            <TextBlock Grid.Row="7" Text="项目编辑（改名、增删类别、类别改名）" Margin="0,12,0,4" />
            <Grid Grid.Row="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="EditProjectNameBox" Text="{Binding EditProjectName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="项目名称" />
                <Button Grid.Column="1" x:Name="RenameProjectButton" Content="改名" Command="{Binding RenameProjectCommand}"
                        Width="80" Height="26" Margin="8,0,0,0" />
            </Grid>
            <Grid Grid.Row="9" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="NewClassNameBox" Text="{Binding NewClassName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="添加类别" />
                <Button Grid.Column="1" x:Name="AddClassButton" Content="添加类别" Command="{Binding AddClassCommand}"
                        Width="90" Height="26" Margin="8,0,0,0" />
                <TextBox Grid.Column="2" x:Name="RemoveClassNameBox" Text="{Binding RemoveClassName, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Margin="12,0,0,0" ToolTip="要删除的类别名" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="RemoveClassButton" Content="删除类别" Command="{Binding RemoveClassCommand}" Width="90" Height="26" />
                    <CheckBox Content="同时删除数据" IsChecked="{Binding RemoveClassWithData}"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="10" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="RenameClassOldBox" Text="{Binding RenameClassOld, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="原类别名" />
                <TextBox Grid.Column="1" x:Name="RenameClassNewBox" Text="{Binding RenameClassNew, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" ToolTip="新类别名" />
                <Button Grid.Column="2" x:Name="RenameClassButton" Content="类别改名" Command="{Binding RenameClassCommand}"
                        Width="100" Height="26" Margin="8,0,0,0" />
            </Grid>

            <StackPanel Grid.Row="11" Margin="0,12,0,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="数据导入（类别、图片来源文件夹；批次留空自动生成）" VerticalAlignment="Center" />
                    <TextBox x:Name="ImportTreeSourceBox" Text="{Binding ImportTreeSource, UpdateSourceTrigger=PropertyChanged}"
                             Width="200" Margin="16,0,0,0" ToolTip="批量来源根目录：来源/类别/批次/*.png" />
                    <Button x:Name="ImportTreeButton" Content="批量导入" Command="{Binding ImportTreeCommand}"
                            Width="90" Height="26" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="摄像头：" VerticalAlignment="Center" />
                    <ComboBox x:Name="CameraDeviceBox" ItemsSource="{Binding CameraDevices}"
                              SelectedItem="{Binding SelectedCameraDevice, Mode=TwoWay}"
                              Width="170" Height="26" />
                    <Button x:Name="CameraCheckButton" Content="检测/刷新" Command="{Binding CameraCheckCommand}"
                            Width="100" Height="26" Margin="8,0,0,0" />
                    <Button x:Name="CameraCaptureButton" Content="拍照" Command="{Binding CameraCommand}"
                            Width="80" Height="26" Margin="8,0,0,0" />
                    <TextBox x:Name="CameraBurstCountBox" Text="{Binding CameraBurstCount, UpdateSourceTrigger=PropertyChanged}"
                             Width="40" Height="26" Margin="8,0,0,0" ToolTip="连拍张数（1–20）" />
                    <Button x:Name="CameraBurstButton" Content="连拍" Command="{Binding CameraBurstCommand}"
                            Width="70" Height="26" Margin="6,0,0,0" />
                    <Button x:Name="CameraPreviewButton" Content="开始预览" Command="{Binding PreviewStartCommand}"
                            Width="90" Height="26" Margin="12,0,0,0" />
                    <Button x:Name="CameraPreviewStopButton" Content="停止预览" Command="{Binding PreviewStopCommand}"
                            Width="90" Height="26" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="ImportClassBox" Text="{Binding ImportClass, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="项目类别名" />
                <TextBox Grid.Column="1" x:Name="ImportSourceBox" Text="{Binding ImportSourcePath, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" ToolTip="包含图片的文件夹" />
                <TextBox Grid.Column="2" x:Name="ImportBatchBox" Text="{Binding ImportBatch, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0,0,0" ToolTip="批次名，例如 batch-1" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="ImportButton" Content="导入图片" Command="{Binding ImportCommand}"
                            Width="100" Height="26" />
                    <CheckBox x:Name="ImportAsTestCheckBox" Content="导入为测试集" IsChecked="{Binding ImportAsTest}"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="13" x:Name="DatasetSummaryTextBlock" Text="{Binding DatasetSummaryText}" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11" Margin="0,6,0,0" />

            <StackPanel Grid.Row="14" Orientation="Horizontal" Margin="0,12,0,4">
                <TextBlock Text="样本（选择后预览；删除会立即重建清单）" VerticalAlignment="Center" />
                <Button x:Name="DeleteSampleButton" Content="删除选中样本" Command="{Binding DeleteSampleCommand}"
                        Width="120" Height="24" Margin="12,0,0,0" />
                <TextBox x:Name="SampleNewNameBox" Text="{Binding SampleNewName, UpdateSourceTrigger=PropertyChanged}"
                         Width="160" Margin="12,0,0,0" ToolTip="样本新文件名（可省略扩展名）" />
                <Button x:Name="RenameSampleButton" Content="重命名样本" Command="{Binding RenameSampleCommand}"
                        Width="100" Height="24" Margin="8,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="15" Height="150">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox Grid.Column="0" x:Name="SampleListBox" ItemsSource="{Binding SampleEntries}"
                         SelectedItem="{Binding SelectedSample, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName" />
                <Border Grid.Column="1" Width="200" Margin="10,0,0,0" BorderBrush="#DDD" BorderThickness="1">
                    <Grid>
                        <Image Source="{Binding SelectedSampleImage}" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Image x:Name="CameraPreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Grid.Row="16" Text="数据清单（训练用 dataset-manifest.json）" Margin="0,12,0,4" />
            <Grid Grid.Row="17">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DatasetManifestPath, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="1" Text="轮数" VerticalAlignment="Center" Margin="10,0,4,0" />
                <TextBox Grid.Column="2" x:Name="EpochsBox" Text="{Binding EpochsText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
            </Grid>

            <StackPanel Grid.Row="18" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="CheckDatasetButton" Content="检查数据" Command="{Binding CheckDatasetCommand}" Width="100" Height="30" />
                    <Button x:Name="DatasetReportButton"
                            AutomationProperties.AutomationId="DatasetReportButton"
                            Content="数据体检" Command="{Binding DatasetReportCommand}"
                            Width="90" Height="30" Margin="8,0,0,0"
                            ToolTip="生成数据集体检报告 runs/dataset-report.md 与逐样本 CSV runs/dataset-samples.csv" />
                    <Button x:Name="OpenDatasetReportButton"
                            AutomationProperties.AutomationId="OpenDatasetReportButton"
                            Content="打开体检报告" Command="{Binding OpenDatasetReportCommand}"
                            Width="110" Height="30" Margin="8,0,0,0"
                            ToolTip="打开数据体检报告 runs/dataset-report.md" />
                    <Button Content="环境自检" Command="{Binding SelfTestCommand}" Width="90" Height="30" Margin="8,0,0,0" />
                    <Button x:Name="TrainButton" Content="训练并发布" Command="{Binding TrainCommand}" Width="110" Height="30" Margin="8,0,0,0" />
                    <TextBlock x:Name="DataCheckStatusText" Text="{Binding DataCheckStatus}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox x:Name="StrictAcceptanceCheckBox" Content="严格验收（要求独立测试集）" IsChecked="{Binding StrictAcceptance}"
                              VerticalAlignment="Center" />
                    <TextBlock Text="每类最少 训练/验证/测试" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <TextBox x:Name="MinTrainBox" AutomationProperties.AutomationId="MinTrainBox" Text="{Binding MinTrainText, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <TextBox x:Name="MinValBox" AutomationProperties.AutomationId="MinValBox" Text="{Binding MinValText, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0,0,0" />
                    <TextBox x:Name="MinTestBox" AutomationProperties.AutomationId="MinTestBox" Text="{Binding MinTestText, UpdateSourceTrigger=PropertyChanged}" Width="48" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="19" ItemsSource="{Binding DataCheckIssues}" Height="80" Margin="0,6,0,0" />

            <TextBlock Grid.Row="20" Text="模型包目录（预测用）" Margin="0,14,0,4" />
            <TextBox Grid.Row="21" x:Name="PackagePathBox" Text="{Binding PackagePath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="22" Text="待测图片" Margin="0,12,0,4" />
            <TextBox Grid.Row="23" x:Name="ImagePathBox" Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="24" Orientation="Horizontal" Margin="0,10">
                <Button x:Name="PredictButton" Content="预测" Command="{Binding PredictCommand}" Width="80" Height="30" />
                <TextBox x:Name="BatchImagesBox" Text="{Binding BatchImagesPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="130" Height="30" Margin="8,0,0,0" ToolTip="批量预测目录（按 类别/批次/*.png 组织可统计准确率）" />
                <Button x:Name="BatchPredictButton" Content="批量预测" Command="{Binding BatchPredictCommand}"
                        Width="80" Height="30" Margin="8,0,0,0" />
                <ComboBox x:Name="ComparePackageCombo"
                          AutomationProperties.AutomationId="ComparePackageCombo"
                          ItemsSource="{Binding ComparePackageOptions}"
                          SelectedItem="{Binding SelectedComparePackage, Mode=TwoWay}"
                          Width="180" Height="30" Margin="8,0,0,0"
                          ToolTip="选择项目内历史模型包" />
                <TextBox x:Name="ComparePackageBox"
                         AutomationProperties.AutomationId="ComparePackageBox"
                         Text="{Binding ComparePackagePath, UpdateSourceTrigger=PropertyChanged}"
                         Width="150" Height="30" Margin="8,0,0,0" ToolTip="对比模型包目录" />
                <Button x:Name="CompareButton"
                        AutomationProperties.AutomationId="CompareButton"
                        Content="模型对比" Command="{Binding CompareCommand}"
                        Width="80" Height="30" Margin="8,0,0,0" />
                <Button Content="取消" Command="{Binding CancelCommand}" Width="80" Height="30" Margin="8,0,0,0" />
                <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="25" x:Name="ArtifactText" Text="{Binding Artifact, StringFormat=产物 ID：{0}}" />

            <TextBlock Grid.Row="26" Text="{Binding RepositoryRoot, StringFormat=仓库：{0}}"
                       FontSize="11" Foreground="Gray" Margin="0,4,0,0" />

            <TextBlock Grid.Row="27" Text="训练结果（最近一次训练）" Margin="0,14,0,4" />
            <TextBlock Grid.Row="28" Text="{Binding TrainingSummary}" TextWrapping="Wrap"
                       FontFamily="Consolas" FontSize="11" />

            <TextBlock Grid.Row="29" Text="误判样本" Margin="0,10,0,4" />
            <ListBox Grid.Row="30" ItemsSource="{Binding MisclassifiedSamples}" Height="100" />

            <StackPanel Grid.Row="31" Orientation="Horizontal" Margin="0,12,0,4">
                <TextBlock Text="训练历史（选择后可重新导出并切换当前模型）" VerticalAlignment="Center" />
                <Button x:Name="ExportRunButton" Content="导出选中运行" Command="{Binding ExportTrainingRunCommand}"
                        Width="120" Height="24" Margin="12,0,0,0" />
                <Button x:Name="OpenRunsButton"
                        AutomationProperties.AutomationId="OpenRunsButton"
                        Content="打开结果目录" Command="{Binding OpenRunsFolderCommand}"
                        Width="120" Height="24" Margin="8,0,0,0"
                        ToolTip="在资源管理器中打开项目 runs 目录（不存在时自动创建）" />
            </StackPanel>
            <StackPanel Grid.Row="32">
                <ListBox x:Name="TrainingRunsListBox" ItemsSource="{Binding TrainingRuns}"
                         SelectedItem="{Binding SelectedTrainingRun, Mode=TwoWay}"
                         DisplayMemberPath="DisplayName" Height="100" />
                <TextBlock Text="批量预测历史（最近 10 次）" Margin="0,8,0,4"
                           FontSize="11" Foreground="Gray" />
                <ListBox x:Name="BatchHistoryListBox"
                         AutomationProperties.AutomationId="BatchHistoryListBox"
                         ItemsSource="{Binding BatchPredictionHistory}"
                         SelectedItem="{Binding SelectedBatchHistory, Mode=TwoWay}"
                         Height="60" ToolTip="最近批量预测结果" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="ViewBatchHistoryButton"
                            AutomationProperties.AutomationId="ViewBatchHistoryButton"
                            Content="查看选中历史" Command="{Binding ViewBatchHistoryCommand}"
                            Width="110" Height="24"
                            ToolTip="读取选中批次的 runs/batch-predict-*.json，把结果摘要追加到下方消息区" />
                    <Button x:Name="ExportBatchHistoryButton"
                            AutomationProperties.AutomationId="ExportBatchHistoryButton"
                            Content="导出历史汇总" Command="{Binding ExportBatchHistoryCommand}"
                            Width="120" Height="24" Margin="8,0,0,0"
                            ToolTip="调用 scripts/batch_history_export.py 生成 runs/batch-history.md 与 runs/batch-history.csv" />
                </StackPanel>
                <TextBlock Text="模型对比历史（最近 10 次）" Margin="0,8,0,4"
                           FontSize="11" Foreground="Gray" />
                <ListBox x:Name="CompareHistoryListBox"
                         AutomationProperties.AutomationId="CompareHistoryListBox"
                         ItemsSource="{Binding CompareHistory}"
                         SelectedItem="{Binding SelectedCompareHistory, Mode=TwoWay}"
                         Height="60" ToolTip="最近模型对比结果：两包准确率与一致率" />
                <Button x:Name="ViewCompareHistoryButton"
                        AutomationProperties.AutomationId="ViewCompareHistoryButton"
                        Content="查看对比历史" Command="{Binding ViewCompareHistoryCommand}"
                        Width="110" Height="24" Margin="0,6,0,0" HorizontalAlignment="Left"
                        ToolTip="读取选中的 runs/compare-*.json，把两包产物/准确率与分歧样本追加到下方消息区" />
            </StackPanel>

            <ListBox Grid.Row="33" ItemsSource="{Binding Messages}" Height="140" Margin="0,12,0,0" />
        </Grid>
    </ScrollViewer>
</Window>
