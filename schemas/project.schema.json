{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://laitp.local/schemas/project.schema.json",
  "title": "LAITP 学生项目（格式 1.x）",
  "description": "docs/project-format.md 的结构约束。类别顺序、模型引用、数据集清单路径与当前模型由 backend/project 校验器补充检查。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_format",
    "project_id",
    "name",
    "task",
    "created_at",
    "updated_at",
    "classes",
    "models",
    "current_model_artifact_id"
  ],
  "properties": {
    "project_format": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "项目格式版本 major.minor。"
    },
    "project_id": { "$ref": "#/$defs/identifier" },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?!.*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$",
      "description": "项目显示名称，允许中文与空格。"
    },
    "task": { "enum": ["image_classification"] },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "classes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/className" },
      "description": "显式有序类别表，数组下标就是类别 ID；样本和模型标签必须与此顺序一致。"
    },
    "dataset_manifest": {
      "type": ["string", "null"],
      "description": "数据集清单相对路径；尚未生成数据时为 null。",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)[^/<>:\"|?*\\x00-\\x1f]+(?:/[^/<>:\"|?*\\x00-\\x1f]+)*$",
      "description": "数据集清单相对路径；尚未生成数据时可省略。"
    },
    "models": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/modelReference" }
    },
    "current_model_artifact_id": {
      "type": ["string", "null"],
      "description": "当前模型产物 ID；非空时必须存在于 models 中。"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "className": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!.*[\\x00-\\x1f\\x7f])\\S(?:.*\\S)?$"
    },
    "modelReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256", "created_at"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["training", "export"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*//)[^/<>:\"|?*\\x00-\\x1f]+(?:/[^/<>:\"|?*\\x00-\\x1f]+)*$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
